<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Decho.ViewModels"
             xmlns:views="using:Decho.Views"
             x:Class="Decho.Views.MessageListView"
             x:DataType="vm:ChatViewModel">
    <ScrollViewer Name="MessageScrollViewer">
        <ItemsControl ItemsSource="{Binding Messages}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MessageViewModel">
                    <StackPanel>
                        <Grid ColumnDefinitions="*, Auto, *"
                              Margin="5 4"
                              IsVisible="{Binding ShowUnreadMarker}">
                            <Border Height="1" Background="#E68C3C" />
                            <TextBlock Grid.Column="1"
                                       Text="New messages"
                                       Foreground="#E68C3C"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="8 0" />
                            <Border Grid.Column="2" Height="1" Background="#E68C3C" />
                        </Grid>
                        <views:MessageItemView />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
