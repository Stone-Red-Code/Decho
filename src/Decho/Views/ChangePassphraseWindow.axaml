<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Decho.Views.ChangePassphraseWindow"
        Title="Change Passphrase"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Icon="/Assets/Decho.ico">
    <StackPanel Margin="12" Spacing="8">
        <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" />
        <TextBox x:Name="CurrentBox" Watermark="Current passphrase" PasswordChar="*" />
        <TextBox x:Name="NewBox" Watermark="New passphrase" PasswordChar="*" />
        <TextBox x:Name="ConfirmBox" Watermark="Repeat new passphrase" PasswordChar="*" />
        <TextBlock x:Name="ErrorText" Foreground="IndianRed" TextWrapping="Wrap" IsVisible="False" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" IsCancel="True" Click="OnCancelClicked" />
            <Button Content="Change" IsDefault="True" Click="OnChangeClicked" />
        </StackPanel>
    </StackPanel>
</Window>
