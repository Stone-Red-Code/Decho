<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        x:Class="Decho.Views.ConnectDialogWindow"
        Title="Connect to Server"
        Width="400"
        MinWidth="400"
        MinHeight="300"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Icon="/Assets/Decho.ico">
    <Border Padding="15">
        <StackPanel Spacing="8">
            <TextBlock Text="Server URL:" FontWeight="SemiBold" />
            <TextBox x:Name="UrlBox" Watermark="http://localhost:5000" />

            <TextBlock Text="Username:" FontWeight="SemiBold" />
            <TextBox x:Name="UserBox" Watermark="username" />

            <TextBlock Text="Password:" FontWeight="SemiBold" />
            <TextBox x:Name="PassBox" Watermark="password" PasswordChar="*" />

            <CheckBox x:Name="RememberCheck" Content="Remember me" IsChecked="True" />

            <TextBlock Text="Display Name (optional):" FontWeight="SemiBold" />
            <TextBox x:Name="DisplayNameBox" Watermark="Display name" />

            <TextBlock Text="Invite Code (optional):" FontWeight="SemiBold" />
            <TextBox x:Name="InviteCodeBox" Watermark="Invite code" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="10"
                        Margin="0 4 0 0">
                <Button Content="Login" Width="90" Click="OnLoginClick" />
                <Button Content="Register" Width="90" Click="OnRegisterClick" />
                <Button Content="Cancel" Width="90" Click="OnCancelClick" />
            </StackPanel>

            <TextBlock x:Name="SavedHeader"
                       Text="--- Saved Servers ---"
                       HorizontalAlignment="Center"
                       IsVisible="False" />
            <ListBox x:Name="ServersList"
                     Height="120"
                     IsVisible="False" />
        </StackPanel>
    </Border>
</Window>
