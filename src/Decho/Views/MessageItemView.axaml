<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:Decho.ViewModels"
			 xmlns:dto="using:EchoHub.Core.DTOs"
			 xmlns:conv="using:Decho.Converters"
			 xmlns:views="using:Decho.Views"
			 x:Class="Decho.Views.MessageItemView"
			 x:DataType="vm:MessageViewModel"
			 ClipToBounds="False">
	<UserControl.Resources>
		<conv:BoolToOpacityConverter x:Key="BoolOpacityConverter" />
	</UserControl.Resources>
	<UserControl.Styles>
		<Style Selector="Grid.message">
			<Setter Property="Margin" Value="5 10 5 0" />
		</Style>
		<Style Selector="Grid.message.continuation">
			<Setter Property="Margin" Value="5 0" />
		</Style>
		<Style Selector="Grid.message Border.hoverBackground">
			<Setter Property="Margin" Value="-3 -3 -3 0" />
			<Setter Property="Opacity" Value="0" />
		</Style>
		<Style Selector="Grid.message.continuation Border.hoverBackground">
			<Setter Property="Margin" Value="-3 0" />
		</Style>
		<Style Selector="Grid.message:pointerover Border.hoverBackground">
			<Setter Property="Opacity" Value="1" />
		</Style>
		<Style Selector="Grid.message TextBlock.hoverHint">
			<Setter Property="Opacity" Value="0" />
		</Style>
		<Style Selector="Grid.message:pointerover TextBlock.hoverHint">
			<Setter Property="Opacity" Value="0.5" />
		</Style>
	</UserControl.Styles>
	<Grid Classes="message"
		  Classes.continuation="{Binding IsGroupContinuation}"
		  ColumnDefinitions="44, *"
		  Background="Transparent">
		<Grid.ContextMenu>
			<ContextMenu Opening="OnContextMenuOpening">
				<MenuItem x:Name="ReplyMenuItem" Header="Reply" Click="OnReplyMenuClick" />
				<MenuItem x:Name="MentionMenuItem" Header="Mention" Click="OnMentionMenuClick" />
				<MenuItem x:Name="ProfileMenuItem" Header="View profile" Click="OnProfileMenuClick" />
				<Separator x:Name="ActionsSeparator" />
				<MenuItem x:Name="CopyTextMenuItem" Header="Copy text" Click="OnCopyTextMenuClick" />
				<MenuItem x:Name="CopyIdMenuItem" Header="Copy message ID" Click="OnCopyIdMenuClick" />
				<Separator x:Name="DeleteSeparator" />
				<MenuItem x:Name="DeleteMenuItem" Header="Delete message" Click="OnDeleteMenuClick" />
			</ContextMenu>
		</Grid.ContextMenu>
		<Border Classes="hoverBackground"
				Grid.ColumnSpan="2"
				Background="#18808080"
				CornerRadius="4"
				IsHitTestVisible="False" />
		<Border Grid.ColumnSpan="2" Background="#2645a1" IsHitTestVisible="False" CornerRadius="4"
				Opacity="{Binding IsHighlighted, Converter={StaticResource BoolOpacityConverter}}">
			<Border.Transitions>
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.3" />
				</Transitions>
			</Border.Transitions>
		</Border>
		<TextBlock Classes="hoverHint"
				   IsVisible="{Binding IsGroupContinuation}"
				   Text="{Binding ShortTimeText}"
				   FontSize="10"
				   HorizontalAlignment="Center"
				   VerticalAlignment="Top"
				   Margin="0 1 8 -20" />
		<views:AvatarView VerticalAlignment="Top"
						  IsVisible="{Binding !IsGroupContinuation}"
						  HorizontalAlignment="Left"
						  Width="36"
						  Height="36"
						  Margin="0 0 0 -36"
						  Cursor="Hand"
						  Username="{Binding AuthorUsername}"
						  ServerUrl="{Binding ServerUrl}"
						  FallbackName="{Binding AuthorName}"
						  PointerPressed="OnAuthorNamePointerPressed" />

		<StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0 0 20 0">
			<StackPanel Orientation="Horizontal"
						Margin="0 2 0 4"
						IsVisible="{Binding !IsGroupContinuation}">
				<TextBlock VerticalAlignment="Top"
						   Text="{Binding AuthorName}"
						   FontWeight="Bold"
						   Foreground="{Binding AuthorColor}"
						   Cursor="Hand"
						   PointerPressed="OnAuthorNamePointerPressed" />
				<TextBlock VerticalAlignment="Top"
						   Text="{Binding TimeText}"
						   FontSize="10"
						   Margin="5 0 0 0" />
			</StackPanel>
			<TextBlock x:Name="ReplyQuote"
					   VerticalAlignment="Top"
					   TextWrapping="Wrap"
					   FontSize="11"
					   Opacity="0.5"
					   IsVisible="{Binding HasReply}"
					   PointerPressed="OnReplyQuotePointerPressed" />
			<SelectableTextBlock x:Name="MessageContent"
								 ContextFlyout="{x:Null}"
								 VerticalAlignment="Top"
								 TextWrapping="Wrap"
								 IsVisible="{Binding ShowContent}" />
			<ItemsControl ItemsSource="{Binding Attachments}"
						  IsVisible="{Binding HasAttachments}"
						  Margin="0 4 0 0">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="dto:AttachmentDto">
						<StackPanel Margin="0 2 0 2">
							<Image Loaded="OnAttachmentImageLoaded"
								   MaxHeight="300"
								   MaxWidth="400"
								   HorizontalAlignment="Left"
								   Cursor="Hand"
								   PointerPressed="OnAttachmentImagePointerPressed" />
							<TextBlock Text="{Binding FileName}"
									   FontSize="11"
									   Opacity="0.7" />
							<Button Content="Download"
									Click="OnAttachmentDownloadClicked"
									FontSize="11"
									Padding="5 1"
									HorizontalAlignment="Left"
									Margin="0 2 0 0" />
						</StackPanel>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
			<ItemsControl ItemsSource="{Binding Embeds}"
						  IsVisible="{Binding HasEmbeds}"
						  Margin="0 4 0 0">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="dto:EmbedDto">
						<Border BorderThickness="3 0 0 0"
								BorderBrush="{Binding ThemeColor, TargetNullValue=Gray}"
								CornerRadius="4"
								Background="{DynamicResource UiTheme01}"
								Padding="10"
								Margin="0 2 0 2">
							<StackPanel Spacing="2">
								<TextBlock Text="{Binding SiteName}"
										   FontSize="11"
										   Opacity="0.6"
										   IsVisible="{Binding SiteName, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
								<TextBlock Text="{Binding Title}"
										   FontWeight="Bold"
										   TextWrapping="Wrap" />
								<TextBlock Text="{Binding Description}"
										   FontSize="12"
										   Opacity="0.8"
										   TextWrapping="Wrap"
										   IsVisible="{Binding Description, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
							</StackPanel>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</StackPanel>
		<TextBlock Grid.Column="1"
				   Classes="hoverHint"
				   Text="↩"
				   FontSize="10"
				   HorizontalAlignment="Right"
				   VerticalAlignment="Top"
				   Margin="0 1 5 -20"
				   Cursor="Hand"
				   PointerPressed="OnReplyPointerPressed" />
	</Grid>
</UserControl>
